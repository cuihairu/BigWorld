name  := cellapp
type  := unit_test

include $(BW_COMPONENT_HEADER)

cxxSource =									\
	main									\
	../profile								\
	test_buffered_ghost_messages			\
	test_entity_message_log_scope			\
	test_entity_message_routing				\
	test_entity_type_migration				\
	test_reload_script_plan					\
	../buffered_ghost_message				\
	../buffered_ghost_message_queue			\
	../buffered_ghost_messages				\
	../buffered_ghost_messages_for_entity	\

dependsOn += server resmgr network math cstdmf zip

# Same source-root include paths as the cellapp binary target
# (../Makefile.rules incFlags). The test target pulls production server TUs
# in, and those include across component dirs
# ("baseapp/baseapp_int_interface.hpp" et al); the migration seam tests add
# entity.hpp, whose header chain reaches entitydef and physics2 headers.
# Nothing resolves without these - a failure here is a compile, not a link
# one (2026-10-20 probe). The seam itself is inline in entity.ipp, so no
# additional libraries are linked for it.
incFlags_$(binName) += -I$(BW_ABS_SRC)
incFlags_$(binName) += -I$(BW_ABS_SRC_SERVER)

usePython := 1

include $(BW_COMPONENT_FOOTER)

# vi: filetype=make
# Makefile.rules - cellapp/unit_test
