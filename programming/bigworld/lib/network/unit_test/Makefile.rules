name  := network
type  := unit_test

include $(BW_COMPONENT_HEADER)

cxxSource =							\
	main							\
	common_interface				\
	packet_generator				\
	test_auto_switch				\
	test_baseapp_death				\
	test_channel					\
	test_channel_version			\
	test_compresslength				\
	test_config						\
	test_exposed_message_range		\
	test_elliptic_curve 			\
	test_flood						\
	test_fragment					\
	test_interface					\
	test_login_challenge			\
	test_mangle						\
	test_msgtypes					\
	test_netmask					\
	test_networkstats				\
	test_overflow					\
	test_receive_window				\
	test_reliable					\
	test_replay_header				\
	test_replay_tick_loader			\
	test_network_checksum_schemes	\
	test_server_finder				\
	test_snprintf 					\
	test_stream						\
	test_symmetric_block_cipher		\
	test_zip_stream					\
	test_tcp_channels				\
	test_threadsafety				\
	test_websockets 				\

useOpenSSL = 1

# zip is the vcpkg zlib staged as libzip.a (third_party_vcpkg.mak); libnetwork
# needs it for zip_stream.cpp / compression_stream.cpp. Unit tests set
# noDefaultDependencies, so BW_DEPENDS_ON's "zip" does not reach this link line.
# resmgr: libnetwork's compression_stream.cpp references DataSection
# (initCompressionType); replay tick loader tests pull that object in.
dependsOn += network connection resmgr math cstdmf zip

# BWT-25539: CPPUnitLite2 fails to compile on RHEL 7
cxxFlags_$(binName) += -Wno-float-equal

include $(BW_COMPONENT_FOOTER)

# vi: filetype=make
# Makefile.rules - network/unit_test
