name  := pyscript
type  := unit_test

include $(BW_COMPONENT_HEADER)

cxxSource =							\
	main							\
	integer_range_checker			\
	test_conversion					\
	test_extensions					\
	test_pyobject_base				\
	test_python_and_stl				\
	test_python_integration			\
	test_py_data_section			\
	test_py_output_writer			\
	test_pywatcher					\
	test_resource_table				\
	test_script_events				\
	test_stl_refs					\
	test_stl_to_py					\

dependsOn += \
	pyscript 		\
	script			\
	resmgr 			\
	zip 			\
	math 			\
	cstdmf

usePython := 1

ldLibs_$(binName) += -ldl

include $(BW_COMPONENT_FOOTER)

# vi: filetype=make
# Makefile.rules - pyscript/unit_test
