{
  "comments": {
    "lineComment": null,
    "blockComment": ["<!--", "-->"]
  },
  "brackets": [
    ["<", ">"],
    ["{", "}"],
    ["[", "]"],
    ["(", ")"]
  ],
  "autoClosingPairs": [
    { "open": "<", "close": ">" },
    { "open": "{", "close": "}" },
    { "open": "[", "close": "]" },
    { "open": "(", "close": ")" },
    { "open": "\"", "close": "\"" }
  ],
  "surroundingPairs": [
    ["<", ">"],
    ["{", "}"],
    ["[", "]"],
    ["(", ")"],
    ["\"", "\""]
  ],
  "indentationGuides": {
    "betweenTokens": "^\\s*</?\\w"
  },
  "wordPattern": "[A-Za-z_][\\w.-]*",
  "folding": {
    "markers": {
      "start": "^\\s*<\\w",
      "end": "^\\s*</\\w"
    }
  }
}
